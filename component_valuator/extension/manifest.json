{
  "manifest_version": 3,
  "name": "OLX Component Collector",
  "version": "1.1.0",
  "description": "Automatycznie zbiera widoczne wyniki OLX dla kolejki komponentów.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://www.olx.pl/*",
    "http://127.0.0.1:8766/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}